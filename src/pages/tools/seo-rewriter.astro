---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
---
<Layout title="SEO Rewriter">
  <Container>
    <Sectionhead>
      <Fragment slot="title">SEO Rewriter</Fragment>
      <Fragment slot="desc">
        ช่วยปรับและเรียบเรียงข้อความให้เหมาะกับ SEO อ่านง่าย และเป็นธรรมชาติมากขึ้น
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">
          ข้อความของคุณ
        </h2>

        <div class="mt-6 space-y-5">
          <div>
            <label
              for="content"
              class="block text-sm font-medium text-gray-700 mb-2">
              ข้อความที่ต้องการเรียบเรียงใหม่
            </label>
            <textarea
              id="content"
              rows="10"
              placeholder="วางข้อความที่ต้องการปรับปรุงที่นี่..."
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            ></textarea>
          </div>

          <div>
            <label
              for="keyword"
              class="block text-sm font-medium text-gray-700 mb-2">
              Keyword หลัก
            </label>
            <input
              id="keyword"
              type="text"
              placeholder="เช่น วิธีทำ SEO"
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            />
          </div>

          <button
            id="rewrite"
            class="w-full px-5 py-3 rounded-md bg-black text-white hover:bg-gray-800 transition">
            เรียบเรียงข้อความ
          </button>
        </div>
      </div>

      <div>
        <div class="bg-gray-50 rounded-lg p-8">
          <h2 class="font-medium text-2xl text-gray-800">
            ผลลัพธ์
          </h2>

          <div class="mt-6">
            <p class="text-gray-500">ข้อความที่เรียบเรียงแล้ว</p>
            <p
              id="result"
              class="text-lg leading-relaxed text-gray-800 mt-2 whitespace-pre-line">
              -
            </p>
          </div>

          <div class="mt-6 pt-6 border-t border-gray-200">
            <div class="flex items-center justify-between">
              <p class="text-gray-500">จำนวนตัวอักษร</p>
              <p id="characterCount" class="font-semibold text-gray-800">
                0
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<script>
  const contentInput = document.querySelector(
    "#content"
  ) as HTMLTextAreaElement;

  const keywordInput = document.querySelector(
    "#keyword"
  ) as HTMLInputElement;

  const rewriteButton = document.querySelector("#rewrite");
  const result = document.querySelector("#result");
  const characterCount = document.querySelector("#characterCount");

  rewriteButton?.addEventListener("click", () => {
    const content = contentInput.value.trim();
    const keyword = keywordInput.value.trim();

    if (!content) {
      result!.textContent = "กรุณากรอกข้อความที่ต้องการเรียบเรียง";
      characterCount!.textContent = "0";
      return;
    }

    const rewritten = keyword
      ? `${content}\n\nKeyword ที่เกี่ยวข้อง: ${keyword}`
      : content;

    result!.textContent = rewritten;
    characterCount!.textContent = String(rewritten.length);
  });
</script>