---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
---

<Layout title="SERP Preview">
  <Container>
    <Sectionhead>
      <Fragment slot="title">SERP Preview</Fragment>
      <Fragment slot="desc">
        ดูตัวอย่างว่าหน้าเว็บไซต์ของคุณอาจแสดงผลบน Google Search อย่างไร
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-5xl mt-16">
      <!-- Input -->
      <div>
        <h2 class="font-medium text-2xl text-gray-800">
          ข้อมูลหน้าเว็บไซต์
        </h2>

        <div class="mt-6 space-y-5">
          <div>
            <label
              for="title"
              class="block text-sm font-medium text-gray-700 mb-2">
              SEO Title
            </label>

            <input
              id="title"
              type="text"
              maxlength="70"
              placeholder="เช่น วิธีเลือกซื้อคอนโดสำหรับมือใหม่ | BaanCal"
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            />

            <p id="titleCount" class="text-sm text-gray-400 mt-2">
              0 / 70 ตัวอักษร
            </p>
          </div>

          <div>
            <label
              for="url"
              class="block text-sm font-medium text-gray-700 mb-2">
              URL
            </label>

            <input
              id="url"
              type="text"
              placeholder="https://baancal.com/blog/example"
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            />
          </div>

          <div>
            <label
              for="description"
              class="block text-sm font-medium text-gray-700 mb-2">
              Meta Description
            </label>

            <textarea
              id="description"
              rows="5"
              maxlength="160"
              placeholder="เขียนคำอธิบายสั้น ๆ เกี่ยวกับหน้าเว็บไซต์ของคุณ..."
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 resize-none"
            ></textarea>

            <p id="descriptionCount" class="text-sm text-gray-400 mt-2">
              0 / 160 ตัวอักษร
            </p>
          </div>
        </div>
      </div>

      <!-- Preview -->
      <div>
        <h2 class="font-medium text-2xl text-gray-800">
          ตัวอย่างบน Google
        </h2>

        <div class="mt-6 border border-gray-200 rounded-lg p-6 bg-white">
          <p
            id="previewUrl"
            class="text-sm text-green-700 truncate">
            https://baancal.com
          </p>

          <h3
            id="previewTitle"
            class="text-xl text-blue-700 mt-1 leading-snug">
            ตัวอย่างชื่อหน้าเว็บไซต์ของคุณ
          </h3>

          <p
            id="previewDescription"
            class="text-sm text-gray-600 mt-2 leading-relaxed">
            ตัวอย่างคำอธิบายหน้าเว็บไซต์จะแสดงตรงนี้ คุณสามารถกรอก Meta
            Description เพื่อดูตัวอย่างข้อความที่อาจปรากฏในผลการค้นหา
          </p>
        </div>

        <div class="mt-6 bg-gray-50 rounded-lg p-6">
          <h3 class="font-medium text-lg text-gray-800">
            คำแนะนำ
          </h3>

          <ul class="mt-3 space-y-2 text-sm text-slate-500">
            <li>
              • เขียน Title ให้สั้น กระชับ และสื่อความหมายของหน้า
            </li>
            <li>
              • เขียน Meta Description ให้บอกเนื้อหาหลักของหน้าอย่างชัดเจน
            </li>
            <li>
              • ตัวอย่างนี้เป็นการจำลองเบื้องต้น ผลลัพธ์จริงบน Google อาจแตกต่างกัน
            </li>
          </ul>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<script>
  const titleInput = document.querySelector("#title") as HTMLInputElement;
  const urlInput = document.querySelector("#url") as HTMLInputElement;
  const descriptionInput = document.querySelector(
    "#description"
  ) as HTMLTextAreaElement;

  const titleCount = document.querySelector("#titleCount");
  const descriptionCount = document.querySelector("#descriptionCount");

  const previewTitle = document.querySelector("#previewTitle");
  const previewUrl = document.querySelector("#previewUrl");
  const previewDescription = document.querySelector(
    "#previewDescription"
  );

  const updatePreview = () => {
    const title = titleInput.value.trim();
    const url = urlInput.value.trim();
    const description = descriptionInput.value.trim();

    previewTitle!.textContent =
      title || "ตัวอย่างชื่อหน้าเว็บไซต์ของคุณ";

    previewUrl!.textContent =
      url || "https://baancal.com";

    previewDescription!.textContent =
      description ||
      "ตัวอย่างคำอธิบายหน้าเว็บไซต์จะแสดงตรงนี้ คุณสามารถกรอก Meta Description เพื่อดูตัวอย่างข้อความที่อาจปรากฏในผลการค้นหา";

    titleCount!.textContent =
      `${titleInput.value.length} / 70 ตัวอักษร`;

    descriptionCount!.textContent =
      `${descriptionInput.value.length} / 160 ตัวอักษร`;
  };

  titleInput.addEventListener("input", updatePreview);
  urlInput.addEventListener("input", updatePreview);
  descriptionInput.addEventListener("input", updatePreview);
</script>