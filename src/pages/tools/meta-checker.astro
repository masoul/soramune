---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Meta Checker">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Meta Checker</Fragment>
      <Fragment slot="desc">
        ตรวจสอบ Meta Title และ Meta Description พร้อมดูจำนวนตัวอักษรเบื้องต้น
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">
          ข้อมูล Meta ของคุณ
        </h2>

        <div class="mt-6 space-y-5">
          <div>
            <label
              for="title"
              class="block text-sm font-medium text-gray-700 mb-2">
              Meta Title
            </label>
            <input
              id="title"
              type="text"
              placeholder="เช่น วิธีทำ SEO สำหรับมือใหม่"
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            />
          </div>

          <div>
            <label
              for="description"
              class="block text-sm font-medium text-gray-700 mb-2">
              Meta Description
            </label>
            <textarea
              id="description"
              rows="5"
              placeholder="เช่น เรียนรู้วิธีทำ SEO สำหรับมือใหม่ พร้อมเทคนิค..."
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            ></textarea>
          </div>

          <button
            id="check"
            class="w-full px-5 py-3 rounded-md bg-black text-white hover:bg-gray-800 transition">
            ตรวจสอบ Meta
          </button>
        </div>
      </div>

      <div>
        <div class="bg-gray-50 rounded-lg p-8">
          <h2 class="font-medium text-2xl text-gray-800">
            ผลการตรวจสอบ
          </h2>

          <div class="mt-6 space-y-5">
            <div>
              <p class="text-gray-500">Meta Title</p>
              <p id="titleResult" class="text-xl font-semibold text-gray-800 mt-1">
                -
              </p>
            </div>

            <div>
              <p class="text-gray-500">Meta Description</p>
              <p
                id="descriptionResult"
                class="text-xl font-semibold text-gray-800 mt-1">
                -
              </p>
            </div>

            <div class="pt-5 border-t border-gray-200">
              <p class="text-gray-500">สถานะ</p>
              <p id="statusResult" class="text-xl font-bold text-gray-800 mt-1">
                -
              </p>
            </div>

            <p class="text-sm text-gray-400 leading-relaxed">
              การตรวจสอบนี้เป็นการประเมินเบื้องต้นจากจำนวนตัวอักษร
              ไม่ได้เป็นการรับรองว่า Meta จะเหมาะสมกับทุกกรณีของ SEO
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<script>
  const titleInput = document.querySelector("#title") as HTMLInputElement;
  const descriptionInput = document.querySelector(
    "#description"
  ) as HTMLTextAreaElement;

  const checkButton = document.querySelector("#check");

  const titleResult = document.querySelector("#titleResult");
  const descriptionResult = document.querySelector("#descriptionResult");
  const statusResult = document.querySelector("#statusResult");

  checkButton?.addEventListener("click", () => {
    const title = titleInput.value.trim();
    const description = descriptionInput.value.trim();

    if (!title || !description) {
      titleResult!.textContent = "กรุณากรอกข้อมูลให้ครบ";
      descriptionResult!.textContent = "-";
      statusResult!.textContent = "-";
      return;
    }

    const titleLength = title.length;
    const descriptionLength = description.length;

    const titleGood = titleLength >= 30 && titleLength <= 60;
    const descriptionGood =
      descriptionLength >= 120 && descriptionLength <= 160;

    titleResult!.textContent =
      `${titleLength} ตัวอักษร — ${
        titleGood ? "อยู่ในช่วงที่แนะนำ" : "ควรปรับความยาว"
      }`;

    descriptionResult!.textContent =
      `${descriptionLength} ตัวอักษร — ${
        descriptionGood ? "อยู่ในช่วงที่แนะนำ" : "ควรปรับความยาว"
      }`;

    statusResult!.textContent =
      titleGood && descriptionGood
        ? "Meta พร้อมใช้งาน"
        : "ควรปรับปรุง Meta";
  });
</script>