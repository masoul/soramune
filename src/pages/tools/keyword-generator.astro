---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Keyword Generator">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Keyword Generator</Fragment>
      <Fragment slot="desc">
        ช่วยหา Keyword ที่เกี่ยวข้องจากหัวข้อหรือคำค้นหลัก เพื่อนำไปใช้วางแผน SEO
      </Fragment>
    </Sectionhead>

    <div class="grid md:grid-cols-2 gap-10 mx-auto max-w-4xl mt-16">
      <div>
        <h2 class="font-medium text-2xl text-gray-800">
          หัวข้อหรือ Keyword ของคุณ
        </h2>

        <div class="mt-6 space-y-5">
          <div>
            <label
              for="keyword"
              class="block text-sm font-medium text-gray-700 mb-2">
              Keyword หลัก
            </label>
            <input
              id="keyword"
              type="text"
              placeholder="เช่น ทำ SEO"
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            />
          </div>

          <div>
            <label
              for="topic"
              class="block text-sm font-medium text-gray-700 mb-2">
              หัวข้อหรือรายละเอียดเพิ่มเติม
            </label>
            <textarea
              id="topic"
              rows="5"
              placeholder="เช่น ต้องการทำ SEO สำหรับเว็บไซต์ธุรกิจ"
              class="w-full px-4 py-3 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400"
            ></textarea>
          </div>

          <button
            id="generate"
            class="w-full px-5 py-3 rounded-md bg-black text-white hover:bg-gray-800 transition">
            สร้าง Keyword
          </button>
        </div>
      </div>

      <div>
        <div class="bg-gray-50 rounded-lg p-8">
          <h2 class="font-medium text-2xl text-gray-800">
            Keyword ที่เกี่ยวข้อง
          </h2>

          <div id="results" class="mt-6 flex flex-wrap gap-2">
            <span class="text-gray-400">
              -
            </span>
          </div>

          <div class="mt-6 pt-6 border-t border-gray-200">
            <p class="text-sm text-gray-400 leading-relaxed">
              Keyword ที่แสดงเป็นแนวทางเบื้องต้นสำหรับนำไปต่อยอดในการวางแผนเนื้อหาและ SEO
            </p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</Layout>

<script>
  const keywordInput = document.querySelector("#keyword") as HTMLInputElement;
  const topicInput = document.querySelector("#topic") as HTMLTextAreaElement;
  const generateButton = document.querySelector("#generate");
  const results = document.querySelector("#results");

  generateButton?.addEventListener("click", () => {
    const keyword = keywordInput.value.trim();
    const topic = topicInput.value.trim();

    if (!keyword) {
      results!.innerHTML =
        '<span class="text-gray-400">กรุณากรอก Keyword หลัก</span>';
      return;
    }

    const keywords = [
      keyword,
      `${keyword} คืออะไร`,
      `วิธี${keyword}`,
      `${keyword} สำหรับมือใหม่`,
      `${keyword} เบื้องต้น`,
      `${keyword} มีอะไรบ้าง`,
      `${keyword} ทำอย่างไร`,
      `${keyword} ตัวอย่าง`,
      `เรียนรู้${keyword}`,
      `${keyword} ที่ดีที่สุด`,
    ];

    if (topic) {
      keywords.push(`${keyword} ${topic.split(" ").slice(0, 3).join(" ")}`);
    }

    results!.innerHTML = keywords
      .map(
        (item) =>
          `<span class="px-3 py-2 rounded-md bg-white border border-gray-200 text-sm text-gray-700">${item}</span>`
      )
      .join("");
  });
</script>