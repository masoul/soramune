---
import Container from "@/components/container.astro";
import Sectionhead from "@/components/sectionhead.astro";
import Layout from "@/layouts/Layout.astro";
---
<Layout title="Meta Title Generator">
  <Container>
    <Sectionhead>
      <Fragment slot="title">Meta Title Generator</Fragment>
      <Fragment slot="desc">
        แปลงบทความหรือเนื้อหาเป็น Meta Title ที่กระชับและสื่อความหมายตรงกับเนื้อหา
      </Fragment>
    </Sectionhead>

    <div class="grid lg:grid-cols-2 gap-10 mx-auto max-w-6xl mt-16">

      <!-- Input -->
      <div>
        <h2 class="font-medium text-2xl text-gray-800">
          เนื้อหาของคุณ
        </h2>

        <p class="text-lg leading-relaxed text-slate-500 mt-3">
          วางบทความหรือเนื้อหาทั้งหมดที่ต้องการสร้าง Meta Title ได้เลย
          ระบบจะวิเคราะห์ใจความสำคัญจากเนื้อหา
        </p>

        <div class="mt-6">
          <textarea
            id="content"
            rows="18"
            placeholder="วางบทความของคุณที่นี่...

ตัวอย่าง:
การซื้อคอนโดไม่ได้มีแค่เงินสำหรับจ่ายค่าห้องเท่านั้น
ก่อนตัดสินใจซื้อควรเตรียมงบประมาณสำหรับเงินจอง
เงินดาวน์ ค่าโอนกรรมสิทธิ์ และค่าส่วนกลาง..."
            class="w-full px-4 py-4 rounded-md border border-gray-300 focus:outline-none focus:ring-2 focus:ring-gray-400 resize-y"
          ></textarea>
        </div>

        <button
          id="generate"
          class="w-full mt-4 px-5 py-3 rounded-md bg-black text-white hover:bg-gray-800 transition">
          สร้าง Meta Title
        </button>
      </div>


      <!-- Result -->
      <div>
        <div class="bg-gray-50 rounded-lg p-8">

          <h2 class="font-medium text-2xl text-gray-800">
            ผลลัพธ์
          </h2>

          <!-- Title -->
          <div class="mt-6">
            <div class="flex justify-between items-center">
              <p class="text-gray-500">
                Meta Title
              </p>

              <p
                id="status"
                class="text-sm text-gray-400">
                -
              </p>
            </div>

            <div
              class="mt-2 bg-white border border-gray-200 rounded-md p-4">
              <p
                id="titleResult"
                class="text-xl font-semibold text-gray-800 leading-relaxed">
                -
              </p>
            </div>
          </div>


          <!-- Character count -->
          <div class="mt-6 pt-6 border-t border-gray-200">

            <div class="flex justify-between">
              <p class="text-gray-500">
                จำนวนตัวอักษร
              </p>

              <p
                id="characterCount"
                class="font-semibold text-gray-800">
                0
              </p>
            </div>

            <div class="mt-3 h-2 bg-gray-200 rounded-full overflow-hidden">
              <div
                id="progress"
                class="h-full bg-gray-800 rounded-full"
                style="width: 0%">
              </div>
            </div>

            <p class="text-sm text-gray-400 mt-2">
              ระบบพยายามรักษาความยาวให้อยู่ในช่วงที่เหมาะสมสำหรับการแสดงผลบน Search
            </p>
          </div>


          <!-- SERP Preview -->
          <div class="mt-8 pt-6 border-t border-gray-200">

            <p class="text-gray-500 mb-3">
              Google Search Preview
            </p>

            <div class="bg-white border border-gray-200 rounded-md p-5">

              <p
                id="previewTitle"
                class="text-xl text-blue-700 leading-snug">
                ตัวอย่าง Meta Title
              </p>

              <p class="text-sm text-green-700 mt-1">
                https://example.com/page
              </p>

              <p class="text-sm text-gray-600 mt-1 leading-relaxed">
                ตัวอย่างผลการค้นหาจะแสดง Meta Title ของหน้าเว็บของคุณตรงบริเวณนี้
              </p>

            </div>
          </div>


          <!-- Source -->
          <div class="mt-8 pt-6 border-t border-gray-200">

            <p class="text-gray-500">
              ใจความที่ระบบเลือก
            </p>

            <p
              id="sourceText"
              class="text-sm text-gray-500 mt-2 leading-relaxed">
              -
            </p>

          </div>

        </div>
      </div>

    </div>
  </Container>
</Layout>

<script>
  const contentInput = document.querySelector("#content") as HTMLTextAreaElement;
  const generateButton = document.querySelector("#generate") as HTMLButtonElement;
  const titleResult = document.querySelector("#titleResult") as HTMLElement;
  const characterCount = document.querySelector("#characterCount") as HTMLElement;
  const progress = document.querySelector("#progress") as HTMLElement;
  const status = document.querySelector("#status") as HTMLElement;
  const previewTitle = document.querySelector("#previewTitle") as HTMLElement;
  const sourceText = document.querySelector("#sourceText") as HTMLElement;

  // 1. ระบบคัดเลือกประโยคด้วย TextRank Algorithm (วิเคราะห์ความสัมพันธ์ของประโยค)
  function textRankSummarize(sentences: string[]): string {
    if (sentences.length === 0) return "";
    if (sentences.length === 1) return sentences[0];

    // สร้าง Matrix คำนวณความเหมือนกันของประโยค (Cosine Similarity แบบย่อ)
    const similarityMatrix: number[][] = Array(sentences.length)
      .fill(0)
      .map(() => Array(sentences.length).fill(0));

    for (let i = 0; i < sentences.length; i++) {
      for (let j = 0; j < sentences.length; j++) {
        if (i !== j) {
          const wordsA = new Set(sentences[i].split(" "));
          const wordsB = new Set(sentences[j].split(" "));
          const intersection = [...wordsA].filter(x => wordsB.has(x));
          const score = intersection.length / (Math.log(wordsA.size) + Math.log(wordsB.size) + 1);
          similarityMatrix[i][j] = score;
        }
      }
    }

    // คำนวณคะแนน Graph Rank
    const ranks = Array(sentences.length).fill(1);
    for (let iter = 0; iter < 10; iter++) {
      for (let i = 0; i < sentences.length; i++) {
        let sum = 0;
        for (let j = 0; j < sentences.length; j++) {
          if (i !== j && similarityMatrix[j][i] > 0) {
            sum += similarityMatrix[j][i] * ranks[j];
          }
        }
        ranks[i] = 0.15 + 0.85 * sum;
      }
    }

    // เลือกประโยคที่ได้คะแนนความเชื่อมโยงสูงสุด
    let maxIdx = 0;
    for (let i = 1; i < ranks.length; i++) {
      if (ranks[i] > ranks[maxIdx]) maxIdx = i;
    }

    return sentences[maxIdx];
  }

  // 2. ปรับคำและโครงสร้างใหม่ให้กลายเป็น Meta Title
  function synthesizeMetaTitle(coreSentence: string, fullContent: string): string {
    let clean = coreSentence.trim().replace(/\s+/g, " ");

    // ดึง Keyword หลักประเด็นเด่น
    const isQuestion = clean.includes("?") || clean.includes("ทำไม") || clean.includes("อย่างไร");
    
    // Pattern สำหรับเรียบเรียงใหม่เป็น Meta Title (Paraphrase Framework)
    if (clean.includes("ค่าใช้จ่าย") || clean.includes("งบประมาณ") || clean.includes("ราคา")) {
      return `สรุปค่าใช้จ่ายและงบประมาณที่ต้องรู้: ${clean.slice(0, 40)}...`;
    }

    if (clean.includes("วิธี") || clean.includes("ขั้นตอน")) {
      return `คู่มือและวิธีแนะนำ: ${clean.slice(0, 45)}`;
    }

    // หากความยาวเกิน 60 ตัวอักษร ตัดตกแต่งให้ประโยคสมบูรณ์
    if (clean.length > 55) {
      clean = clean.substring(0, 52) + "...";
    }

    return clean;
  }

  generateButton.addEventListener("click", () => {
    const content = contentInput.value.trim();
    if (!content) return;

    // แยกประโยคตามเครื่องหมายขึ้นบรรทัดใหม่หรือมหัพภาค
    const rawSentences = content
      .split(/[\n\.\!\?]/)
      .map(s => s.trim())
      .filter(s => s.length > 10);

    if (rawSentences.length === 0) {
      titleResult.textContent = "เนื้อหาสั้นเกินไป";
      return;
    }

    // ประมวลผลหาประโยคใจความหลักจริงด้วย Graph Algorithm
    const bestSentence = textRankSummarize(rawSentences);
    const finalTitle = synthesizeMetaTitle(bestSentence, content);

    // Update UI
    titleResult.textContent = finalTitle;
    previewTitle.textContent = finalTitle;
    characterCount.textContent = String(finalTitle.length);
    sourceText.textContent = bestSentence;
    
    const percentage = Math.min((finalTitle.length / 60) * 100, 100);
    progress.style.width = `${percentage}%`;
    status.textContent = finalTitle.length <= 60 ? "ความยาวเหมาะสม" : "ยาวเกินไป";
    status.className = finalTitle.length <= 60 ? "text-sm text-green-600" : "text-sm text-orange-600";
  });
</script>