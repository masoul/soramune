
---
const {
  title = "ค้นพบคำทำนายของคุณ",
  description = "ลองเปิดใจรับคำแนะนำผ่านศาสตร์แห่งการทำนาย เพื่อค้นหามุมมองใหม่ ๆ ให้กับเรื่องที่กำลังคิด",
  image = "",
  link = "/siamsee",
  category = "แนะนำ",
} = Astro.props;
---

<div class="my-10">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xl font-semibold text-violet-950">
      สำรวจคำทำนายยยยยยยยยยยยยยย
    </h2>

    <span class="text-xs text-violet-500 tracking-wider">
      SORAMUNE
    </span>
  </div>

  <a
    href={link}
    class="group block border border-violet-100 rounded-2xl overflow-hidden bg-white hover:shadow-lg hover:shadow-violet-100/60 transition duration-300"
  >
    {
      image ? (
        <img
          src={image}
          alt={title}
          class="w-full aspect-[16/7] object-cover"
          loading="lazy"
        />
      ) : (
        <div class="w-full aspect-[16/7] bg-gradient-to-br from-violet-950 via-violet-900 to-indigo-950 flex flex-col items-center justify-center text-white">
          <span class="text-6xl mb-3" aria-hidden="true">☾</span>
          <span class="text-sm tracking-[0.3em] text-violet-200">
            SORAMUNE
          </span>
        </div>
      )
    }

    <div class="p-6 md:p-8">
      <span class="inline-block text-xs font-medium text-violet-700 bg-violet-50 rounded-full px-3 py-1">
        {category}
      </span>

      <h3 class="text-xl md:text-2xl font-semibold text-violet-950 mt-3 group-hover:text-violet-700 transition">
        {title}
      </h3>

      <p class="text-slate-600 mt-3 leading-relaxed">
        {description}
      </p>

      <div class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-violet-700 group-hover:gap-3 transition-all">
        เริ่มค้นหาคำทำนาย
        <span aria-hidden="true">→</span>
      </div>
    </div>
  </a>
</div>
