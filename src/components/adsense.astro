---
const { slot = "" } = Astro.props;
---

<div
  style="display: block; width: 100%; max-width: 728px; min-height: 180px; margin: 32px auto; background: #f3f4f6; border: 1px solid #d1d5db; border-radius: 8px; text-align: center; padding: 50px 10px;"
>
  <div style="font-size: 12px; color: #9ca3af;">
    ADVERTISEMENT
  </div>

  <div style="font-size: 14px; color: #9ca3af; margin-top: 8px;">
    Google AdSense Preview
  </div>

  {slot && (
    <div style="font-size: 12px; color: #d1d5db; margin-top: 4px;">
      Ad Slot: {slot}
    </div>
  )}
</div>