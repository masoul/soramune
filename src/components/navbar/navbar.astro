---
import Container from "@/components/container.astro";
import Link from "@/components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "คำทำนาย",
    path: "#",
    children: [
      {
        title: "เซียมซีออนไลน์",
        path: "/siamsee",
      },
      {
        title: "ดวงประจำวัน",
        path: "/daily-fortune",
      },
      {
        title: "ไพ่ทำนาย",
        path: "/tarot",
      },
    ],
  },
  {
    title: "บทความ",
    path: "/blog",
  },
  {
    title: "เกี่ยวกับเรา",
    path: "/about",
  },
  {
    title: "ติดต่อเรา",
    path: "/contact",
  },
];
---

<Container>
  <header class="flex flex-col lg:flex-row justify-between items-center my-5">
    <Astronav>
      <div class="flex w-full lg:w-auto items-center justify-between">
        <a href="/" class="text-xl">
          <span class="font-bold text-violet-800">Sora</span><span
            class="text-slate-700">mune</span>
        </a>

        <div class="block lg:hidden">
          <MenuIcon class="w-5 h-5 text-gray-800" />
        </div>
      </div>

      <MenuItems class="hidden w-full lg:w-auto mt-2 lg:flex lg:mt-0">
        <ul class="flex flex-col lg:flex-row lg:gap-3">
          {
            menuitems.map((item, index) => (
              <>
                {item.children && (
                  <Dropdown
                    title={item.title}
                    children={item.children}
                    lastItem={index === menuitems.length - 1}
                  />
                )}

                {!item.children && (
                  <li>
                    <a
                      href={item.path}
                      class="flex lg:px-3 py-2 items-center text-gray-600 hover:text-violet-700 transition-colors"
                    >
                      <span>{item.title}</span>
                    </a>
                  </li>
                )}
              </>
            ))
          }
        </ul>
      </MenuItems>
    </Astronav>
  </header>
</Container>