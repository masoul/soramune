---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-500">
    ค้นหาคำทำนายในเรื่องที่คุณสนใจ
  </h2>

  <div
    class="flex gap-8 md:gap-16 items-center justify-center mt-10 flex-wrap text-center"
  >
    <div class="w-32 md:w-40">
      <div class="text-3xl md:text-4xl">☾</div>
      <p class="font-semibold mt-3">เซียมซีออนไลน์</p>
    </div>

    <div class="w-32 md:w-40">
      <div class="text-3xl md:text-4xl">☀</div>
      <p class="font-semibold mt-3">ดวงประจำวัน</p>
    </div>

    <div class="w-32 md:w-40">
      <div class="text-3xl md:text-4xl">✧</div>
      <p class="font-semibold mt-3">ไพ่ทำนาย</p>
    </div>

    <div class="w-32 md:w-40">
      <div class="text-3xl md:text-4xl">☁</div>
      <p class="font-semibold mt-3">ข้อคิดและแนวทางชีวิต</p>
    </div>
  </div>
</div>