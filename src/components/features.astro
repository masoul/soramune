
---
import { Icon } from "astro-icon/components";

const features = [
  {
    title: "เซียมซีออนไลน์",
    description: "ตั้งจิตอธิษฐานและเสี่ยงเซียมซี รับคำทำนายเพื่อเป็นแนวทางในชีวิต",
    icon: "bx:leaf",
    link: "#siamsee",
  },
  {
    title: "ดวงประจำวัน",
    description: "สำรวจคำทำนายประจำวัน พร้อมแนวทางรับมือเรื่องราวที่อาจพบเจอ",
    icon: "bx:sun",
    link: "#daily-fortune",
  },
  {
    title: "ไพ่ทำนาย",
    description: "เปิดไพ่ค้นหาคำแนะนำเกี่ยวกับความรัก การงาน และเส้นทางชีวิต",
    icon: "bx:moon",
    link: "#tarot",
  },
];
---

<div class="mt-16 md:mt-0">
  <h2 class="text-4xl lg:text-5xl font-bold lg:tracking-tight">
    ค้นพบคำทำนายของคุณ
  </h2>

  <p class="text-lg mt-4 text-slate-600">
    เริ่มต้นค้นหาคำแนะนำและแนวทางสำหรับชีวิตผ่านศาสตร์แห่งการทำนาย
  </p>
</div>

<div class="grid sm:grid-cols-2 md:grid-cols-3 mt-16 gap-8">
  {
    features.map((item) => (
      <a href={item.link} class="flex gap-4 items-start group">
        <div class="mt-1 bg-black rounded-full p-2 w-8 h-8 shrink-0">
          <Icon class="text-white" name={item.icon} />
        </div>

        <div>
          <h3 class="font-semibold text-lg group-hover:text-gray-500 transition">
            {item.title}
          </h3>

          <p class="text-slate-500 mt-2 leading-relaxed">
            {item.description}
          </p>
        </div>
      </a>
    ))
  }
</div>
